<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Как играть — Lord of Mysteries"
        Width="700" Height="660" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Loaded by Ui/HowToPlayWindow.cs; the text comes from installer/HowToPlay.md. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14,24,14">
            <StackPanel>
                <TextBlock Text="Как играть" FontSize="19" FontWeight="Bold" Foreground="{StaticResource GoldBrush}"/>
                <TextBlock Text="От установки игры до запуска на русском" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12,24,12">
            <Button x:Name="CloseButton" Content="Закрыть" IsCancel="True" HorizontalAlignment="Right" MinWidth="110"/>
        </Border>
        <FlowDocumentScrollViewer x:Name="Viewer" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="12,4,6,4" Focusable="False"/>
    </DockPanel>
</Window>
