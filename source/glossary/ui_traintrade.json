{
  "title": "Интерфейс и «Магнат» (TrainTrade): товары, лавки, карты, заголовки (TASK-022)",
  "source": "Согласованный канон пользователя 2026-09-27, docs/tasks/TASK-022-untranslated-v306-quality.md, раздел 4.",
  "format": {
    "cn": "термин в source_cn",
    "ru": "канон в тексте и подписи",
    "ru_match": "регулярка (без учёта регистра), по которой GlossaryCheck.ps1 считает канон найденным",
    "forbidden": "регулярки известных неверных вариантов; канон других терминов той же строки маскируется перед проверкой",
    "cn_exclude": "подстроки source_cn, в которых термин — ложное совпадение (вырезаются до поиска)",
    "scan_markup": "термин ищется и внутри {…}-вставок; -Import сверяет числа макросов {n,m,"
  },
  "terms": [
    { "cn": "窖藏拉菲干红", "en": "Cellared Lafite Red", "ru": "Выдержанный красный «Лафит»",
      "ru_match": "выдержанн\\w*\\s+красн\\w*\\s+«?лафит",
      "forbidden": ["погребальн", "в подвале", "выдержанного в погребе"],
      "cn_exclude": [], "note": "窖藏 в названиях товаров = «Выдержанный»; другие уровни по образцу: 稀·拉菲干红 «Редкий красный «Лафит»»" },

    { "cn": "物产简介", "en": "Product Introduction", "ru": "Описание",
      "ru_match": "описани",
      "forbidden": ["введение"],
      "cn_exclude": [], "note": "не «Описание товара» — решение пользователя" },

    { "cn": "食铺", "en": "Food Shop", "ru": "Лавка Снеди",
      "ru_match": "лавк\\w*\\s+снеди",
      "forbidden": ["продовольственн", "продуктов(ый|ая) (магазин|лавк)", "закусочн", "\\bмагазин\\b"],
      "cn_exclude": [], "note": "«Снеди» с большой буквы" },

    { "cn": "商行", "en": "Trading Company", "ru": "Торговый дом",
      "ru_match": "торгов\\w*\\s+дом",
      "forbidden": ["торгов(ая|ой) фирм", "торгов(ая|ой) палат", "торгов(ая|ой) лавк"],
      "cn_exclude": [], "note": "" },

    { "cn": "酒庄", "en": "Winery", "ru": "Винодельня",
      "ru_match": "винодель",
      "forbidden": ["винн(ый|ого) завод"],
      "cn_exclude": [], "note": "" },

    { "cn": "工业站", "en": "Industrial Station", "ru": "Промышленная станция",
      "ru_match": "промышленн\\w*\\s+станци",
      "forbidden": [],
      "cn_exclude": [], "note": "" },

    { "cn": "始发站", "en": "Departure Station", "ru": "Станция отправления",
      "ru_match": "станци\\w*\\s+отправлени",
      "forbidden": [],
      "cn_exclude": [], "note": "" },

    { "cn": "熟客", "en": "Regular Customer", "ru": "Постоянный клиент",
      "ru_match": "постоянн\\w*\\s+клиент",
      "forbidden": ["\\bобычн"],
      "cn_exclude": [], "note": "название карты «Постоянный клиент · <станция>»" },

    { "cn": "备货", "en": "Stock", "ru": "Запас",
      "ru_match": "запас",
      "forbidden": ["чул"],
      "cn_exclude": [], "note": "" },

    { "cn": "预判", "en": "Prediction", "ru": "Прогноз",
      "ru_match": "прогноз",
      "forbidden": [],
      "cn_exclude": ["早已预判", "难以预判", "如何预判"], "note": "" },

    { "cn": "好礼", "en": "Good Gift", "ru": "Подарок",
      "ru_match": "подар",
      "forbidden": ["хороший подарок"],
      "cn_exclude": [], "note": "" },

    { "cn": "押宝", "en": "Bet", "ru": "Ставка",
      "ru_match": "ставк",
      "forbidden": [],
      "cn_exclude": [], "note": "" },

    { "cn": "非酒庄", "en": "Non-Winery", "ru": "не Винодельня",
      "ru_match": "не\\s+винодель",
      "forbidden": ["невинн", "не-винн", "винный завод"],
      "cn_exclude": [], "note": "" },

    { "cn": "食铺生效", "en": "takes effect", "ru": "срабатывает",
      "ru_match": "сраб[ао]т",
      "forbidden": ["эффективн", "действительн"],
      "cn_exclude": [], "note": "生效 в эффектах карт «Магната» («<карта>·<станция>生效»); 生效 вне «Магната» (套装, 秘偶, 烙印, 大世界不生效…) в глоссарий не входит" },
    { "cn": "商行生效", "en": "takes effect", "ru": "срабатывает",
      "ru_match": "сраб[ао]т",
      "forbidden": ["эффективн", "действительн"],
      "cn_exclude": [], "note": "生效 в эффектах карт «Магната»" },
    { "cn": "酒庄生效", "en": "takes effect", "ru": "срабатывает",
      "ru_match": "сраб[ао]т",
      "forbidden": ["эффективн", "действительн"],
      "cn_exclude": [], "note": "生效 в эффектах карт «Магната» (и 非酒庄生效)" },

    { "cn": "食铺失效", "en": "fails", "ru": "не срабатывает",
      "ru_match": "не\\s+сраб[ао]т",
      "forbidden": ["провал", "вышл[аи] из строя", "проиграна"],
      "cn_exclude": [], "note": "失效 в эффектах карт «Магната»; 烙印已失效 — отдельный термин" },
    { "cn": "商行失效", "en": "fails", "ru": "не срабатывает",
      "ru_match": "не\\s+сраб[ао]т",
      "forbidden": ["провал", "вышл[аи] из строя", "проиграна"],
      "cn_exclude": [], "note": "失效 в эффектах карт «Магната»" },
    { "cn": "酒庄失效", "en": "fails", "ru": "не срабатывает",
      "ru_match": "не\\s+сраб[ао]т",
      "forbidden": ["провал", "вышл[аи] из строя", "проиграна"],
      "cn_exclude": [], "note": "失效 в эффектах карт «Магната» (и 非酒庄失效)" },

    { "cn": "简介", "en": "Introduction", "ru": "Описание",
      "ru_match": "описани|(^|\\s)(о|об|обо)\\s",
      "forbidden": ["введение"],
      "cn_exclude": [], "note": "заголовок: «Описание» или «Об …»; «Введение» допустимо только для 引言 / 入门" },

    { "cn": "介绍", "en": "Introduction", "ru": "Описание",
      "ru_match": "описани|(^|\\s)(о|об|обо)\\s",
      "forbidden": ["введение"],
      "cn_exclude": [], "note": "заголовок: «Описание» или «Об …»; «Введение» допустимо только для 引言 / 入门" },

    { "cn": "匹配", "en": "Matchmaking", "ru": "подбор (игроков)",
      "ru_match": "подбор",
      "forbidden": ["сватовств", "сопоставлен", "подходит для"],
      "cn_exclude": ["动势匹配", "多目标匹配"], "note": "" },

    { "cn": "标点", "en": "Map Marker", "ru": "метка",
      "ru_match": "мет(к|ок)",
      "forbidden": ["пунктуац"],
      "cn_exclude": ["标点符号", "目标点", "坐标点", "诗集新增的标点", "标点要像"], "note": "метка на карте: 标点筛选 «Фильтр меток», 战术标点 «тактическая метка»; строки про стихи (诗) — ложные совпадения" },

    { "cn": "烙印已失效", "en": "Brand expired", "ru": "(срок истёк)",
      "ru_match": "срок\\s+ист[её]к",
      "forbidden": ["бренд", "марк", "срок годности", "клеймо (истекло|утратило|недейств|неактивн)", "烙印"],
      "cn_exclude": [], "scan_markup": true, "note": "макрос {n,m,(срок истёк)}, числа {n,m, не менять" }
  ]
}
