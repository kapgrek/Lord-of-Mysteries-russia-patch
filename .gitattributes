# Lua and JSON are hashed/parsed byte-for-byte by the runtime and the installer:
# always LF, regardless of core.autocrlf (CRLF here caused a hash mismatch).
*.lua  text eol=lf
*.json text eol=lf

# LuaJIT bytecode with a .lua extension (header 1B 4C 4A): must never be eol-converted
patch_payload/Saved/Mods/lua/cpdd_translation/** binary

# Binary data
*.bin    binary
*.exe    binary
*.zip    binary
*.ico    binary
*.png    binary
*.uasset binary
*.oodle  binary
